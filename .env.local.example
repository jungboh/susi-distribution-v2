# Supabase 프로젝트 기본 URL. https://<project-ref>.supabase.co 형식만 사용합니다.
# /rest/v1, /auth/v1, /functions/v1 경로와 따옴표를 포함하지 마세요.
SUPABASE_URL=

# 선택 사항: 이미 이 이름을 쓰는 배포 환경에서는 SUPABASE_URL 대신 사용할 수 있습니다.
# 브라우저에 공개 가능한 프로젝트 URL만 입력하고 service role key는 절대 NEXT_PUBLIC_로 만들지 마세요.
NEXT_PUBLIC_SUPABASE_URL=

# 서버 전용 service_role key. 브라우저 코드나 GitHub에 실제 값을 올리지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 학급 세션 쿠키 서명용 32자 이상의 임의 문자열. 다른 앱과 별도 값을 사용하세요.
TEACHER_AUTH_SECRET=
